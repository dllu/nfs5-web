# Import inside the lawrence.lu, daniel.lawrence.lu site block.
@nfs5 path /nfs5 /nfs5/*
handle @nfs5 {
	root * /www/misc
	header Cross-Origin-Opener-Policy same-origin
	header Cross-Origin-Embedder-Policy require-corp
	@nfs5Asset path /nfs5/assets/*
	header @nfs5Asset Cache-Control "public, max-age=31536000, immutable"
	@nfs5Code not path /nfs5/assets/*
	header @nfs5Code Cache-Control no-cache
	file_server {
		precompressed gzip
	}
}
